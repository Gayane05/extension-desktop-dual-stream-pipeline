# Project C++ style. Mirrors the existing Google-ish layout (4-space indent,
# 100-column limit, left-aligned pointers) with one deliberate deviation:
# control-statement braces (if/else/for/while/switch) open on their own line.
BasedOnStyle: Google
IndentWidth: 4
ColumnLimit: 100
PointerAlignment: Left
DerivePointerAlignment: false
AccessModifierOffset: -4
BreakBeforeBraces: Custom
BraceWrapping:
  AfterControlStatement: Always
  BeforeElse: true
  BeforeCatch: true
  AfterFunction: false
  AfterClass: false
  AfterStruct: false
  AfterNamespace: false
  AfterEnum: false
  AfterUnion: false
  BeforeWhile: false
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortFunctionsOnASingleLine: Inline
