# Project C++ style. Mirrors the existing Google-ish layout (4-space indent,
# 100-column limit, left-aligned pointers) with one deliberate deviation:
# control-statement braces (if/else/for/while/switch), function-definition
# braces, and namespace/struct/class braces all open on their own line.
BasedOnStyle: Google
IndentWidth: 4
ColumnLimit: 100
PointerAlignment: Left
DerivePointerAlignment: false
AccessModifierOffset: -4
BreakBeforeBraces: Custom
BraceWrapping:
  AfterControlStatement: Always
  BeforeElse: true
  BeforeCatch: true
  AfterFunction: true
  AfterClass: true
  AfterStruct: true
  AfterNamespace: true
  AfterEnum: true
  AfterUnion: true
  BeforeWhile: false
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortFunctionsOnASingleLine: Inline
# Always brace control-statement bodies, even single statements.
InsertBraces: true
